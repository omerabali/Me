# Backend Environment Variables
# GERÇEK sırları buraya YAZMA — yalnızca backend/.env dosyasına koy (git'e girmez)
APP_NAME=Omer Abali Portfolio API
ENVIRONMENT=development
DEBUG=True

# Neon Serverless PostgreSQL (zorunlu)
# Örnek format — gerçek connection string'i yalnızca .env içine koy
DATABASE_URL=postgresql://user:pass@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# README göreli resim/link çözümlemesi (CDN). Otomatik proje senkronu YOKTUR.
GITHUB_OWNER=omerabali
GITHUB_AUTO_SYNC=false

# --- Admin (yalnızca şifre + SHA-256 + JWT) ---
# 1) Güçlü rastgele salt seç
# 2) Hash üret (şifrenin kendisini asla commit etme / example'a yazma):
#    python -c "import hashlib; s='SENIN_SALT'; p='SENIN_SIFREN'; print(hashlib.sha256((s+p).encode()).hexdigest())"
# 3) Salt + hash'i yalnızca backend/.env ve canlı host env'ine koy
ADMIN_PASSWORD_SALT=
ADMIN_PASSWORD_SHA256=
# JWT imza anahtarı (üretimde en az 32 karakter, rastgele; örnek değer kullanma)
ADMIN_JWT_SECRET=

# Opsiyonel: panelde "GitHub bilgilerini doldur" (README / commit senkronu YOK)
# Token'ı asla GitHub'a commit etme
GITHUB_TOKEN=

# CORS (virgülle ayrılmış) — canlıda yalnızca kendi domain'in
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Canlı (production) örneği ---
# ENVIRONMENT=production
# DEBUG=False
# ALLOWED_ORIGINS=https://senin-domainin.com

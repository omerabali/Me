# GERÇEK sırları buraya YAZMA — yalnızca backend/.env ve Cloud Run env'ine koy
APP_NAME=Omer Abali Portfolio API
ENVIRONMENT=development
DEBUG=True

# Neon Serverless PostgreSQL
DATABASE_URL=postgresql://user:pass@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

GITHUB_OWNER=omerabali
GITHUB_AUTO_SYNC=false

# --- Admin (SHA-256 + JWT) ---
# Hash üret:
#   python -c "import hashlib,secrets; s=secrets.token_urlsafe(24); p='SENIN_SIFREN'; print('SALT='+s); print('SHA256='+hashlib.sha256((s+p).encode()).hexdigest())"
ADMIN_PASSWORD_SALT=
ADMIN_PASSWORD_SHA256=
ADMIN_JWT_SECRET=

GITHUB_TOKEN=

# Local
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Cloud Run (production) örneği ---
# ENVIRONMENT=production
# DEBUG=False
# ALLOWED_ORIGINS=https://omerabali.github.io
# ADMIN_JWT_SECRET=... (min 32 karakter rastgele)

# Backend Environment Variables
APP_NAME=Omer Abali Portfolio API
ENVIRONMENT=development
DEBUG=True

# Neon Serverless PostgreSQL Database Connection String
# Get your free connection string from https://neon.tech
# Example: postgresql://neondb_owner:password@ep-cool-fog-12345.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# GitHub Configuration
GITHUB_USERNAME=omerabali
GITHUB_TOKEN=

# Cache Configuration (in seconds, default: 1800 = 30 min)
CACHE_TTL_SECONDS=1800

# CORS Configuration (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Featured / Showcased Repositories
SHOWCASED_REPOS=Ai-Medium-Design,Farm-Ai,skill-identity-engine,ai-home-design,health-insurance-pricing

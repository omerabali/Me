# GERÇEK sırları buraya YAZMA — yalnızca backend/.env ve Railway Variables'a koy
APP_NAME=Omer Abali Portfolio API
ENVIRONMENT=development
DEBUG=True

# Neon Serverless PostgreSQL
DATABASE_URL=postgresql://user:pass@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

GITHUB_OWNER=omerabali
GITHUB_AUTO_SYNC=false

# --- Admin (SHA-256 + JWT) ---
# Hash üret:  .\backend\scripts\gen-admin-secrets.ps1 -Password "SIFREN"
ADMIN_PASSWORD_SALT=
ADMIN_PASSWORD_SHA256=
ADMIN_JWT_SECRET=

GITHUB_TOKEN=

# Local
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Railway (production) ---
# ENVIRONMENT=production
# DEBUG=False
# ALLOWED_ORIGINS=https://omerabali.github.io

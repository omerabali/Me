# Production backend API kökü (Render portfolio-api URL)
# GitHub Actions secret (Pages yedek deploy için): VITE_API_BASE_URL
# VITE_API_BASE_URL=https://portfolio-api-xxxx.onrender.com
#
# Asıl canlı: Render Blueprint (render.yaml) → portfolio-web + portfolio-api
# Web build'de VITE_API_BASE_URL API servisinden otomatik gelir.

# GitHub Pages alt yol (yalnızca Pages kullanıyorsan)
# VITE_BASE_PATH=/Me/
